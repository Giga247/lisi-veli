#!/bin/sh
# ატვირთვის წინ ამოწმებს ყველა commit-ს, რომელიც იგზავნება — არა მარტო ბოლოს.
# ასე ძველ ვერსიებში დარჩენილი სახელებიც იჭერს.
ROOT=$(git rev-parse --show-toplevel)
ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
STATUS=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # ტოტის წაშლა
  if [ "$remote_sha" = "$ZERO" ]; then
    RANGE="$local_sha"                            # ახალი ტოტი — ყველაფერი
  else
    RANGE="$local_sha ^$remote_sha"               # მხოლოდ ახალი commit-ები
  fi
  # shellcheck disable=SC2086
  python3 "$ROOT/.githooks/pii_scan.py" --commits $RANGE || STATUS=1
done
exit $STATUS
